# ===========================================================================
# SynapseAir Environment Configuration
# ===========================================================================

# 1. DeepSeek LLM (Main Reasoning & Arbiter Agent)
# Supports DeepSeek direct API, DashScope (Alibaba Cloud), or OpenAI-compatible endpoint
DEEPSEEK_API_KEY=your_deepseek_or_dashscope_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Hermes / Local LLM (Function Calling & Sentinel Parser)
# Compatible with Ollama, vLLM, LMStudio, or OpenRouter
HERMES_API_BASE=http://localhost:11434/v1
HERMES_API_KEY=ollama
HERMES_MODEL=hermes3:latest

# 3. n8n Communication Gateway (WhatsApp HITL Webhook)
# Point this to your n8n workflow webhook URL (e.g., https://your-n8n-instance.app/webhook/synapseair-hitl)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/synapseair-hitl
N8N_CONSENSUS_CALLBACK_URL=http://127.0.0.1:8000/webhook/consensus

# 4. Atlas Sandbox API
ATLAS_API_KEY=atlas_sandbox_demo_key
ATLAS_BASE_URL=https://sandbox.api.atlas.travel/v1
