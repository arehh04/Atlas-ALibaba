# ===========================================================================
# SynapseAir Environment Configuration Template
# ===========================================================================
# Copy this file to .env (dev), .env.staging, or .env.production and fill in
# real values. NEVER commit a populated .env to version control.
# ===========================================================================

# ── Application Secrets ─────────────────────────────────────────────────────
SYNAPSE_API_SECRET=<your-strong-random-secret>
REQUIRE_AUTH=false
JWT_SECRET_KEY=<your-jwt-secret>

# 1. DeepSeek LLM (Main Reasoning & Arbiter Agent)
# Supports DeepSeek direct API, DashScope (Alibaba Cloud), or OpenAI-compatible endpoint
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Hermes / Local LLM (Function Calling & Sentinel Parser)
# Compatible with Ollama, vLLM, LMStudio, or OpenRouter
HERMES_API_BASE=http://localhost:11434/v1
HERMES_API_KEY=ollama
HERMES_MODEL=hermes3:latest

# 3. n8n Communication Gateway (WhatsApp HITL Webhook)
# Point this to your n8n workflow webhook URL (e.g., https://your-n8n-instance.app/webhook/synapseair-hitl)
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=<your-n8n-api-key>
N8N_WEBHOOK_URL=http://localhost:5678/webhook/synapseair-hitl
N8N_CONSENSUS_CALLBACK_URL=http://127.0.0.1:8001/webhook/consensus

# 4. Atlas Sandbox API
ATLAS_CLIENT_ID=<your-atlas-client-id>
ATLAS_CLIENT_SECRET=<your-atlas-client-secret>
ATLAS_API_KEY=<your-atlas-api-key>
ATLAS_BASE_URL=https://sandbox.atriptech.com
