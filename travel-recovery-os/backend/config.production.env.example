# ===========================================================================
# SynapseAir Production Environment Configuration
# ===========================================================================
# Copy this file to .env.production and fill in ALL values before deploying.
# The application will WARN at startup if required keys are missing in
# production mode.
# ===========================================================================

# ── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SYNAPSE_API_SECRET=<strong-random-64-char-string>

# ── DeepSeek LLM ──────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Hermes / Local LLM ────────────────────────────────────────────────────
HERMES_API_BASE=http://ollama:11434/v1
HERMES_API_KEY=ollama
HERMES_MODEL=hermes3:latest

# ── n8n Workflow Automation ───────────────────────────────────────────────
N8N_API_URL=http://n8n:5678
N8N_API_KEY=<your-n8n-api-key>
N8N_WEBHOOK_URL=http://n8n:5678/webhook/
N8N_CONSENSUS_CALLBACK_URL=http://backend:8000/webhook/consensus

# ── Atlas Flight API ─────────────────────────────────────────────────────
ATLAS_API_KEY=<your-atlas-api-key>
ATLAS_BASE_URL=https://sandbox.api.atlas.travel/v1

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<strong-random-64-char-string-different-from-SYNAPSE_API_SECRET>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Observability ─────────────────────────────────────────────────────────
OTEL_ENDPOINT=<your-otel-collector-grpc-endpoint>
LOG_LEVEL=INFO
LOG_JSON=true

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
